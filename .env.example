ANTHROPIC_API_KEY=     # Obrigatório se LLM_PROVIDER=claude
GEMINI_API_KEY=        # Obrigatório se LLM_PROVIDER=gemini
GOOGLE_TTS_API_KEY=    # GCP Console → APIs → Cloud Text-to-Speech → Credenciais → Criar chave
PORT=3000
LLM_PROVIDER=mock      # "mock", "gemini" ou "claude"
NILC_METRIX_URL=       # URL da instância NILC-Metrix, ex: http://localhost:5000 — se vazio usa mock
